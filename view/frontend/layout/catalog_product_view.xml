<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Insert our Extra Price block inside the price area on PDP -->
        <referenceBlock name="product.info.price">
            <block class="Ezzar\ExtraPrice\Block\Product\ExtraPrice"
                   name="product.extra.price"
                   template="Ezzar_ExtraPrice::product/view/extra_price.phtml"
                   after="-"/>
        </referenceBlock>
    </body>
</page>
